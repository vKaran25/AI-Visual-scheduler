# PostgreSQL. The application URL and the direct migration/checkpoint URL can be the same.
DATABASE_URL=postgresql+psycopg://scheduler:scheduler@127.0.0.1:5432/scheduler
DATABASE_DIRECT_URL=postgresql+psycopg://scheduler:scheduler@127.0.0.1:5432/scheduler
JWT_SECRET_KEY=replace_with_a_long_random_secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
COOKIE_SECURE=false
APP_BASE_URL=http://127.0.0.1:8000
CORS_ORIGINS=http://127.0.0.1:8000

OPENROUTER_API_KEY=
OPENROUTER_WORKER_MODEL=baidu/ernie-5.5-flash-preview:free
OPENROUTER_EVALUATOR_MODEL=particle-ai/particle-1:free
OPENROUTER_FALLBACK_MODELS=particle-ai/particle-1:free
LANGGRAPH_STRICT_MSGPACK=true

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/api/google/oauth/callback
GOOGLE_MANAGED_CALENDAR_NAME=Predestination
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Tests must use a separate database with a name ending in _test.
TEST_DATABASE_URL=postgresql+psycopg://scheduler:scheduler@127.0.0.1:5432/scheduler_test

# Model service. Groq is used when GROQ_API_KEY is set (fast, free plan); otherwise OpenRouter.
# Get a free Groq key at https://console.groq.com/keys. LLM_PROVIDER can force 'groq' or 'openrouter'.
LLM_PROVIDER=
GROQ_API_KEY=
GROQ_WORKER_MODEL=openai/gpt-oss-120b
GROQ_EVALUATOR_MODEL=openai/gpt-oss-20b
GROQ_FALLBACK_MODELS=openai/gpt-oss-20b,openai/gpt-oss-120b
